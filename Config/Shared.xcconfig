// Ostinato build configuration. The bundle prefix is defined ONLY here.
// Change OSTINATO_BUNDLE_PREFIX to your reverse-DNS developer prefix
// (e.g. com.yourname) and set DEVELOPMENT_TEAM to sign for devices.

OSTINATO_BUNDLE_PREFIX = com.riad
OSTINATO_BUNDLE_ID = $(OSTINATO_BUNDLE_PREFIX).ostinato
OSTINATO_APP_GROUP = group.$(OSTINATO_BUNDLE_ID)
OSTINATO_ICLOUD_CONTAINER = iCloud.$(OSTINATO_BUNDLE_ID)
OSTINATO_DISPLAY_NAME = Ostinato

DEVELOPMENT_TEAM = YAFG76M77W

// CloudKit push environment: development for Debug, production for Release.
OSTINATO_APS_ENVIRONMENT = development
OSTINATO_APS_ENVIRONMENT[config=Release] = production
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 2

SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
